# Required
OPENAI_API_KEY=sk-...

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=hf_...

# LLM provider used by Day 18 modules in src/ (config.py defaults to "groq").
# Set to "openai" when OPENAI_API_KEY is the only key you have, otherwise
# RAGAS in m4_eval.py sees an empty key and silently returns 0.0 metrics.
LLM_PROVIDER=openai
